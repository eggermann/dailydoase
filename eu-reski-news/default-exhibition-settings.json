{
  "version": 7,
  "paths": {
    "newsDirectory": "eu-reski-news/news/A",
    "outputDirectory": "eu-reski-news/GENERATIONS/news/exhibition"
  },
  "exhibition": {
    "newsRefreshIntervalMs": 86400000,
    "newsRefreshCheckMs": 900000,
    "newsRefreshRetryMs": 900000,
    "mergeCheckMs": 20000,
    "mergeRetryMs": 60000,
    "firstLastGlue": true,
    "glueDurationPattern": [9, 5, 7, 5, 8],
    "glueWaitPattern": "classic",
    "frameOffsetSeconds": 0.25,
    "fadeSeconds": 0.25,
    "randomBridgeThreshold": 0.7
  },
  "generation": {
    "autoMode": false,
    "storyModel": "gpt-4.1-mini",
    "includeSourceCodeContext": true,
    "iterations": 4,
    "pauseMs": 0,
    "articleOrder": "linear",
    "styleReference": true,
    "legacyGuernicaStyleReferencePrompt": true,
    "articleImageReference": true,
    "guernicaLocationReference": false,
    "landscapePrompt": false,
    "preserveCubistVideoStyle": true,
    "videosAfterEachIteration": true,
    "generate-title-cards": true,
    "sceneCount": {
      "mode": "taktmuster",
      "count": 5,
      "takt": 2,
      "numerator": 4,
      "denominator": 4,
      "type": "balanced",
      "bias": 1,
      "minimum": 1,
      "maximum": 12
    },
    "sceneLength": {
      "takt": 4,
      "type": "balanced",
      "multiplier": 1.15,
      "bias": 4.2,
      "minimum": 5,
      "maximum": 8
    },
    "imageProvider": "hf-flux-klein",
    "videoModel": "prunaai:p-video@2-pro",
    "videoResolution": "480p",
    "videoSettingsMode": "cost",
    "videoMode": "image_to_video",
    "videoDirection": "off",
    "storyClou": "off",
    "videoVision": "off",
    "videoAudioDirection": "on",
    "noDialogueNarration": false,
    "videoMaxZoom": 0.08,
    "visualControls": {
      "mode": "scene-specific",
      "symbolic": true,
      "roomDeepness": false,
      "layering": 3
    }
  }
}
